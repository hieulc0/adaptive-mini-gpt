{
  "spec_id": "m77_plan_discovery_spec",
  "version": "1.0",
  "description": "Standardized benchmark specification for M77 autonomous neural skill-plan discovery from observable demonstrations",
  "default_seeds": [42, 43, 44],
  "demonstration_budgets": [0, 2, 4, 8],
  "symbol_vocab_size": 16,
  "symbols": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10", "S11", "S12", "S13", "S14", "S15"],
