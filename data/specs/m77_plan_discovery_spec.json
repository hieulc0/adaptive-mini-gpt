    },
    {
      "task_id": "SHIFT3_THEN_REFLECT",
      "ground_truth_stages": ["CAESAR_SHIFT_MOD3", "COMPLEMENT_REFLECT"],
      "depth": 2
    },
    {
      "task_id": "REFLECT_THEN_AFFINE",
      "ground_truth_stages": ["COMPLEMENT_REFLECT", "AFFINE_TRANSFORM"],
      "depth": 2
    },
    {
      "task_id": "AFFINE_THEN_SHIFT3",
      "ground_truth_stages": ["AFFINE_TRANSFORM", "CAESAR_SHIFT_MOD3"],
      "depth": 2
    }
  ],
  "uncomposable_tasks": [
    {
      "task_id": "BITWISE_XOR_MASK",
      "ground_truth_stages": [],
      "depth": 0
    },
    {
      "task_id": "DECEPTIVE_INVERSION",
      "ground_truth_stages": [],
      "depth": 0
    }
  ],
  "causal_arms": [
    "A_AUTONOMOUS_PLAN_SEARCH",
    "B_PROVIDED_CORRECT_PLAN",
    "C_FIXED_ORDER",
    "D_RANDOM_VALID_PLAN",
    "E_SHUFFLED_DEMONSTRATIONS",
    "F_SINGLE_SKILL",
    "G_WRONG_ORDER",
    "H_FRESH_COMPOUND_ADAPTER",
    "I_REFERENCE_ORACLE"
  ]
}
